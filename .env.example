# =============================================================================
# Swetha's Couture — environment template
# =============================================================================
# Copy this file to ".env" and fill in the values, then restart the dev server.
# For production: paste the same variables into
#   Vercel -> Project -> Settings -> Environment Variables, then redeploy.
#
# Anything prefixed VITE_ is compiled into the browser bundle and is therefore
# PUBLIC. Anything without the prefix is server-side only.
# =============================================================================


# =============================================================================
# Firebase (REQUIRED — the app refuses to start without these)
# =============================================================================
# Firebase Console -> Project settings -> Your apps -> SDK setup and config.
#
# A Firebase web config is public by design: it identifies your project, it does
# not authorise anything. Your data is protected by Firestore Security Rules, so
# make sure those are locked down to signed-in users with the right role.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=


# =============================================================================
# Cloudinary (REQUIRED for design images & payment screenshots)
# =============================================================================
# 1. Free account: https://cloudinary.com/users/register_free
# 2. Copy the "Cloud name" from the dashboard.
# 3. Settings -> Upload -> Add upload preset
#      Signing Mode: Unsigned   <-- important
#      Name it, then put that name below.
# No API secret is used in the browser, so nothing sensitive is exposed.
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset


# ============================================
# BioTime Cloud / ZKBio Time Cloud (OPTIONAL)
# ============================================
# Powers automatic fingerprint check-in / check-out on the Attendance page.
# Without these, Attendance still works — you just enter the times by hand.
#
# ⚠️ NO "VITE_" PREFIX ON THESE.
# The VITE_ prefix is what publishes a variable into the browser bundle. These are
# read only by the server-side proxy (api/biotime.ts), so the password never reaches
# a visitor's browser. Adding VITE_ would leak your BioTime password to the public.
#
# BIOTIME_BASE_URL — your BioTime portal address, no trailing slash.
#   e.g. https://yourcompany.itime.minervaiot.com
BIOTIME_BASE_URL=

# Option A — username + password (works on classic on-premise BioTime 8.x/9.x)
BIOTIME_USERNAME=
BIOTIME_PASSWORD=

# Option B — a token generated in the BioTime portal.
# Newer ZKBio Time Cloud tenants (*.minervaiot.com) block password login over the
# API, so a portal-issued token is the only way in there. If this is set, the
# username/password above are ignored.
BIOTIME_API_TOKEN=

# Header scheme for the token. Leave as JWT unless BioTime support tells you
# otherwise (other valid values: Token, Bearer).
BIOTIME_AUTH_SCHEME=JWT

# Extra hostnames the proxy is allowed to call, comma-separated. Only needed if you
# self-host BioTime on your own domain. The ZKTeco cloud domains are allowed already.
# This is a security control — the proxy refuses any host not on the list, so it can
# never be tricked into fetching an internal address.
BIOTIME_ALLOWED_HOSTS=

# For production, add the same variables in Vercel → Project → Settings →
# Environment Variables, then redeploy.
# ============================================
